{
  "name": "transcription-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "tportal",
  "sourceRoot": "apps/transcription-portal/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": {
          "base": "dist/apps/transcription-portal",
          "browser": "",
          "media": "assets"
        },
        "browser": "apps/transcription-portal/src/main.ts",
        "polyfills": [
          "@angular/localize/init",
          "zone.js"
        ],
        "tsConfig": "apps/transcription-portal/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/transcription-portal/src/assets",
          "apps/transcription-portal/src/contents",
          "apps/transcription-portal/src/config",
          "apps/transcription-portal/src/manifest.json"
        ],
        "styles": [
          "node_modules/maintenance-warning-snackbar/dist/maintenance-warning-snackbar.css",
          "apps/transcription-portal/src/styles.scss"
        ],
        "allowedCommonJsDependencies": [
          "x2js",
          "chart.js",
          "jszip",
          "notifyjs",
          "konva"
        ],
        "scripts": [
          "apps/transcription-portal/src/assets/js/modernizr.js",
          "node_modules/platform/platform.js",
          "node_modules/jszip/dist/jszip.min.js"
        ],
        "serviceWorker": "apps/transcription-portal/ngsw-config.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/transcription-portal/src/environments/environment.ts",
              "with": "apps/transcription-portal/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/transcription-portal/src/environments/environment.ts",
              "with": "apps/transcription-portal/src/environments/environment.dev.ts"
            }
          ],
          "optimization": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 3456
      },
      "configurations": {
        "production": {
          "buildTarget": "transcription-portal:build:production"
        },
        "development": {
          "buildTarget": "transcription-portal:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "transcription-portal:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "transcription-portal:build",
        "staticFilePath": "dist/apps/transcription-portal",
        "spa": true
      }
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "angular",
        "postTargets": ["transcription-portal:github"],
        "baseBranch": "master",
        "releaseAs": "patch",
        "commitMessageFormat": "build({projectName}): release version ${version}"
      }
    },
    "github": {
      "executor": "@jscutlery/semver:github",
      "options": {
        "tag": "${tag}",
        "notes": "${notes}"
      }
    }
  }
}
